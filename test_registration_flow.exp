#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo 'Testing registration email flow...'\r"
expect "# "

# Create a test user to verify resend functionality
send "mysql -u root ctf_users << 'SQLEND'\r"
send "INSERT INTO users (username, email, password, email_verified, verification_token, container_id)\r"
send "VALUES ('testuser', 'testuser@wonkatech.org', SHA2('testpass123', 256), 0, 'test_token_123', NULL)\r"
send "ON DUPLICATE KEY UPDATE email_verified = 0, verification_token = 'test_token_123';\r"
send "\r"
send "SELECT username, email, email_verified FROM users WHERE email_verified = 0;\r"
send "SQLEND\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Test user created with unverified email.'\r"
expect "# "
send "echo ''\r"
expect "# "

# Check mail queue status
send "echo 'Current mail queue:'\r"
expect "# "
send "mailq | head -10\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'Registration flow test complete!'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'You can test the following:'\r"
expect "# "
send "echo '1. Login as testuser/testpass123 at https://wonkatech.org'\r"
expect "# "
send "echo '   - You should see the resend verification link'\r"
expect "# "
send "echo '2. Click the resend link to get a new verification email'\r"
expect "# "
send "echo '3. Register a new user to test email sending'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'Email Status: ✓ Working (local delivery via postfix)'\r"
expect "# "
send "echo 'Resend Feature: ✓ Available for unverified users only'\r"
expect "# "

send "exit\r"
expect eof