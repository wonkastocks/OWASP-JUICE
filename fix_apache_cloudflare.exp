#!/usr/bin/expect -f

set timeout 60
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# Fix Apache config for Cloudflare (HTTP only, Cloudflare handles SSL)
send "cat > /etc/apache2/sites-available/ctf-platform.conf << 'EOF'\r"
send "<VirtualHost *:80>\r"
send "    ServerName wonkatech.org\r"
send "    ServerAlias www.wonkatech.org\r"
send "    ServerAlias 155.138.197.128\r"
send "    DocumentRoot /var/www/ctf-platform\r"
send "    \r"
send "    <Directory /var/www/ctf-platform>\r"
send "        Options Indexes FollowSymLinks\r"
send "        AllowOverride All\r"
send "        Require all granted\r"
send "    </Directory>\r"
send "    \r"
send "    ErrorLog /var/log/apache2/ctf-platform-error.log\r"
send "    CustomLog /var/log/apache2/ctf-platform-access.log combined\r"
send "</VirtualHost>\r"
send "EOF\r"
expect "# "

# Restart Apache
send "systemctl restart apache2\r"
expect "# "

# Check status
send "systemctl status apache2 | head -5\r"
expect "# "

# Test the setup
send "curl -s http://localhost/ | grep -o '<title>.*</title>'\r"
expect "# "

# Check database
send "mysql -u root ctf_platform -e 'SHOW TABLES;'\r"
expect "# "

send "exit\r"
expect eof