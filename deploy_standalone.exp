send "$password\r"
expect eof

# Execute the installation
spawn ssh root@155.138.197.128
expect "password:"
send "$password\r"
expect "root@*"
send "bash /tmp/install_standalone_juice.sh\r"
expect {
    "STANDALONE JUICE SHOP INSTALLED" {
        puts "\n✅ Installation completed successfully!"
    }
    timeout {
        puts "\n⏱️ Installation is taking longer than expected..."
    }
}
