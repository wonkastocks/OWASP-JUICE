#!/usr/bin/expect -f
set timeout 300
set password {\$Hg5sD&8Lp@9}

# Copy the installation script
spawn scp /Users/walterbarr_1/sql-injection-lab/install_standalone_juice.sh root@155.138.197.128:/tmp/
