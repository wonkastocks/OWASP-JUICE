#!/usr/bin/expect -f

set timeout 60
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# Fix dashboard.php to use direct IP for instances (Cloudflare can't proxy ports 3001-3020)
send "cd /var/www/ctf-platform/\r"
expect "# "

# Create a simple PHP script to fix the dashboard
send "cat > fix_dashboard.php << 'PHPEND'\r"
send "<?php\r"
send "// Read dashboard.php\r"
send "\\\$content = file_get_contents('dashboard.php');\r"
send "// Replace HTTPS URLs with direct IP for instance access\r"
send "\\\$content = str_replace(\"'https://wonkatech.org:' . \\\\\\\$port\", \"'http://155.138.197.128:' . \\\\\\\$port\", \\\$content);\r"
send "// Write back\r"
send "file_put_contents('dashboard.php', \\\$content);\r"
send "echo 'Dashboard fixed!';\r"
send "?>\r"
send "PHPEND\r"
expect "# "

# Run the fix script
send "php fix_dashboard.php\r"
expect "# "

# Clean up
send "rm fix_dashboard.php\r"
expect "# "

# Fix all pages to use relative URLs so they work with HTTPS via Cloudflare
send "sed -i 's|https://wonkatech.org/|/|g' *.php\r"
expect "# "

# Enable Apache module for Cloudflare
send "a2enmod remoteip 2>/dev/null\r"
expect "# "

# Reload Apache
send "systemctl reload apache2\r"
expect "# "

# Test
send "echo 'Testing configuration...'\r"
expect "# "
send "curl -s http://localhost/ | grep -o '<title>.*</title>' | head -1\r"
expect "# "

send "echo 'Configuration complete! Access the platform at https://wonkatech.org'\r"
expect "# "
send "echo 'Juice Shop instances will be at http://155.138.197.128:3001-3020'\r"
expect "# "

send "exit\r"
expect eof