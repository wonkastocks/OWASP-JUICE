# First, let's copy the restore script we already have
puts "\nStep 1: Copying restore script..."
spawn scp /Users/walterbarr_1/sql-injection-lab/restore_all_services.sh root@155.138.197.128:/tmp/
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$pass\r"
        expect eof
    }
    timeout {
        puts "Timeout on copy"
        exit 1
    }
}

puts "\nStep 2: Executing restore script..."
spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$pass\r"
        expect "root@*" {
            send "bash /tmp/restore_all_services.sh\r"
            expect {
                "ACCESS URLS" {
                    puts "\n✅ Installation successful!"
                    expect "root@*"
                    send "exit\r"
                }
                timeout {
                    puts "\nScript still running..."
                    send "\r"
                    expect "root@*"
                    send "exit\r"
                }
            }
        }
    }
    timeout {
        puts "Timeout on SSH"
        exit 1
    }
}

puts "\n========================================="
puts "✅ DEPLOYMENT COMPLETE!"
