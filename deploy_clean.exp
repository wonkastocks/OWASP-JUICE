#!/usr/bin/expect -f

set timeout 30
set password {$R00tbeer02}

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Create the clean login page directly on the server
send "cat > /var/www/html/login_clean.php << 'ENDOFFILE'\r"
send "<?php\r"
send "session_start();\r"
send "\$servername = \"localhost\";\r"
send "\$username = \"wally_user\";\r"
send "\$password = \"MonkeyParts2024!\";\r"
send "\$dbname = \"wallys_monkey_parts\";\r"
send "\r"
send "\$conn = new mysqli(\$servername, \$username, \$password, \$dbname);\r"
send "\r"
send "if (\$conn->connect_error) {\r"
send "    die(\"Connection failed: \" . \$conn->connect_error);\r"
send "}\r"
send "\r"
send "\$error = '';\r"
send "\r"
send "if (\$_SERVER\[\"REQUEST_METHOD\"\] == \"POST\") {\r"
send "    \$username = \$_POST\['username'\];\r"
send "    \$password = \$_POST\['password'\];\r"
send "    \r"
send "    // Intentionally vulnerable query for SQL injection demo\r"
send "    \$query = \"SELECT * FROM users WHERE username = '\$username' AND password = MD5('\$password')\";\r"
send "    \$result = \$conn->query(\$query);\r"
send "    \r"
send "    if (\$result && \$result->num_rows > 0) {\r"
send "        \$user = \$result->fetch_assoc();\r"
send "        \$_SESSION\['user_id'\] = \$user\['id'\];\r"
send "        \$_SESSION\['username'\] = \$user\['username'\];\r"
send "        \$_SESSION\['is_admin'\] = \$user\['is_admin'\];\r"
send "        header(\"Location: dashboard.php\");\r"
send "        exit();\r"
send "    } else {\r"
send "        \$error = \"Invalid username or password\";\r"
send "    }\r"
send "}\r"
send "?>\r"
send "<!DOCTYPE html>\r"
send "<html lang=\"en\">\r"
send "<head>\r"
send "    <meta charset=\"UTF-8\">\r"
send "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r"
send "    <title>Login - Wally's Monkey Parts</title>\r"
send "    <style>\r"
send "        * { margin: 0; padding: 0; box-sizing: border-box; }\r"
send "        body {\r"
send "            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r"
send "            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r"
send "            min-height: 100vh;\r"
send "            display: flex;\r"
send "            justify-content: center;\r"
send "            align-items: center;\r"
send "        }\r"
send "        .header-banner {\r"
send "            position: fixed;\r"
send "            top: 0;\r"
send "            left: 0;\r"
send "            right: 0;\r"
send "            background: #ff6b6b;\r"
send "            color: white;\r"
send "            text-align: center;\r"
send "            padding: 12px;\r"
send "            font-size: 14px;\r"
send "            font-weight: 600;\r"
send "            z-index: 1000;\r"
send "        }\r"
send "        .login-container {\r"
send "            background: white;\r"
send "            border-radius: 12px;\r"
send "            box-shadow: 0 20px 60px rgba(0,0,0,0.3);\r"
send "            padding: 40px;\r"
send "            width: 100%;\r"
send "            max-width: 400px;\r"
send "            margin-top: 60px;\r"
send "        }\r"
send "        h1 {\r"
send "            color: #333;\r"
send "            margin-bottom: 30px;\r"
send "            text-align: center;\r"
send "            font-size: 28px;\r"
send "        }\r"
send "        .form-group { margin-bottom: 20px; }\r"
send "        label {\r"
send "            display: block;\r"
send "            margin-bottom: 8px;\r"
send "            color: #555;\r"
send "            font-weight: 500;\r"
send "        }\r"
send "        input\[type=\"text\"\],\r"
send "        input\[type=\"password\"\] {\r"
send "            width: 100%;\r"
send "            padding: 12px;\r"
send "            border: 2px solid #e1e8ed;\r"
send "            border-radius: 8px;\r"
send "            font-size: 16px;\r"
send "            transition: border-color 0.3s;\r"
send "        }\r"
send "        input:focus {\r"
send "            outline: none;\r"
send "            border-color: #667eea;\r"
send "        }\r"
send "        button {\r"
send "            width: 100%;\r"
send "            padding: 14px;\r"
send "            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r"
send "            color: white;\r"
send "            border: none;\r"
send "            border-radius: 8px;\r"
send "            font-size: 16px;\r"
send "            font-weight: 600;\r"
