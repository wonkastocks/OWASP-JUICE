send "            transition: transform 0.2s;\r"
send "        }\r"
send "        button:hover { transform: translateY(-2px); }\r"
send "        .error {\r"
send "            color: #e74c3c;\r"
send "            text-align: center;\r"
send "            margin-bottom: 20px;\r"
send "        }\r"
send "    </style>\r"
send "</head>\r"
send "<body>\r"
send "    <div class=\"header-banner\">\r"
send "        🎉 FREE SHIPPING on orders over \$50! Use code: PRANK2025\r"
send "    </div>\r"
send "    <div class=\"login-container\">\r"
send "        <h1>Login</h1>\r"
send "        <?php if (\$error): ?>\r"
send "            <div class=\"error\"><?php echo \$error; ?></div>\r"
send "        <?php endif; ?>\r"
send "        <form method=\"POST\" action=\"\">\r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"username\">Username</label>\r"
send "                <input type=\"text\" id=\"username\" name=\"username\" required>\r"
send "            </div>\r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"password\">Password</label>\r"
send "                <input type=\"password\" id=\"password\" name=\"password\" required>\r"
send "            </div>\r"
send "            <button type=\"submit\">Sign In</button>\r"
send "        </form>\r"
send "    </div>\r"
send "</body>\r"
send "</html>\r"
send "ENDOFFILE\r"

expect "# "

# Backup and replace
send "cp /var/www/html/login.php /var/www/html/login.php.backup_clean\r"
expect "# "

send "mv /var/www/html/login_clean.php /var/www/html/login.php\r"
expect "# "

send "chown www-data:www-data /var/www/html/login.php\r"
expect "# "

send "chmod 644 /var/www/html/login.php\r"
expect "# "

send "systemctl restart apache2\r"
expect "# "

send "echo 'Clean login page deployed!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nClean login page deployed!"