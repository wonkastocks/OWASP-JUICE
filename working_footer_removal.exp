#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Remove footer sections
send "sed -i '/<footer>/,/<\\/footer>/d' /var/www/html/login.php\r"
expect "# "

# Remove everything from Shop section to end of file
send "sed -i '/#### 🛍️ Shop/,\$d' /var/www/html/login.php\r"
expect "# "

# Add closing body and html tags back
send "echo '</body></html>' >> /var/www/html/login.php\r"
expect "# "

# Also remove any remaining copyright or footer text
send "sed -i '/© 2025/d' /var/www/html/login.php\r"
expect "# "

send "sed -i '/For entertainment purposes/d' /var/www/html/login.php\r"
expect "# "

# Restart Apache
send "systemctl restart apache2\r"
expect "# "

send "echo 'Footer removed successfully!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nFooter removal complete!"