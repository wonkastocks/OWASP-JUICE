#!/usr/bin/expect -f

set timeout 30

# Server details
set server "155.138.197.128"
set user "root"
set pass "\$p4ghetti\$uperD3luxe#"

# Create admin directory
spawn ssh $user@$server "mkdir -p /var/www/html/admin"
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$pass\r" }
}
expect eof

# Copy config.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/config.php $user@$server:/var/www/html/admin/
expect {
    "yes/no" { send "yes\r"; exp_continue }
    "password:" { send "$pass\r" }
}
expect eof

# Copy functions.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/functions.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy admin_login.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/admin_login.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy index.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/index.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

