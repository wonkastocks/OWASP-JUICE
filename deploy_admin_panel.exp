# Set permissions and restart Apache
spawn ssh $user@$server
expect {
    "password:" { send "$pass\r" }
}
expect "# "
send "chown -R www-data:www-data /var/www/html/admin\r"
expect "# "
send "chmod -R 755 /var/www/html/admin\r"
expect "# "
send "chmod 640 /var/www/html/admin/config.php\r"
expect "# "
send "mkdir -p /var/lib/php/sessions\r"
expect "# "
send "chown www-data:www-data /var/lib/php/sessions\r"
expect "# "
send "chmod 700 /var/lib/php/sessions\r"
expect "# "
send "systemctl restart apache2\r"
expect "# "
send "exit\r"
expect eof

puts "\n✅ Admin panel deployed successfully!"
puts "\n📌 Admin Panel Access:"
puts "   URL: http://155.138.197.128/admin/admin_login.php"
puts "   Email: admin@wonkatech.com"
puts "   Password: WonkaAdmin2024!"