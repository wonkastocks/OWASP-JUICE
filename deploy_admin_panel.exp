spawn scp /Users/walterbarr_1/sql-injection-lab/admin/style.css $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy users.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/users.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy progress.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/progress.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy containers.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/containers.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
expect eof

# Copy logout.php
spawn scp /Users/walterbarr_1/sql-injection-lab/admin/logout.php $user@$server:/var/www/html/admin/
expect {
    "password:" { send "$pass\r" }
}
