#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

# SSH and configure Juice Shop currency
spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo 'Configuring Juice Shop to use USD currency...'\r"
expect "# "
send "echo '================================================'\r"
expect "# "

# Stop all Juice Shop containers
send "echo 'Stopping existing Juice Shop containers...'\r"
expect "# "
send "docker stop \$(docker ps -q --filter name=juice) 2>/dev/null || true\r"
expect "# "

# Remove existing containers
send "docker rm \$(docker ps -aq --filter name=juice) 2>/dev/null || true\r"
expect "# "

# Create environment file for Juice Shop configuration
send "echo 'Creating Juice Shop configuration...'\r"
expect "# "
send "cat > /root/juice-config.yml << 'EOF'\r"
send "application:\r"
send "  domain: \"155.138.197.128\"\r"
send "  name: \"WonkaTech CTF Juice Shop\"\r"
send "  logo: \"/assets/public/images/JuiceShop_Logo.png\"\r"
send "  favicon: \"/assets/public/favicon_js.ico\"\r"
send "  theme: \"bluegrey-lightgreen\"\r"
send "  showVersionNumber: true\r"
send "  showGitHubLinks: false\r"
send "  localBackupEnabled: true\r"
send "  altcoinName: \"USD\"\r"
send "  privacyContactEmail: \"wonkatech@gmail.com\"\r"
send "  customMetricsPrefix: \"juice_shop\"\r"
send "  chatBot:\r"
send "    name: \"WonkaBot\"\r"
send "    greeting: \"Welcome to WonkaTech CTF Juice Shop!\"\r"
send "    avatar: \"bot.png\"\r"
send "  social:\r"
send "    twitterUrl: \"https://twitter.com/wonkatech\"\r"
send "    facebookUrl: \"https://www.facebook.com/wonkatech\"\r"
send "    slackUrl: \"https://wonkatech.slack.com\"\r"
send "    redditUrl: \"https://www.reddit.com/r/wonkatech\"\r"
send "    pressKitUrl: \"https://wonkatech.org\"\r"
send "    questionnaireUrl: \"https://wonkatech.org/feedback\"\r"
send "  recyclePage:\r"
send "    topProductImage: \"apple_juice.jpg\"\r"
send "    bottomProductImage: \"apple_pressings.jpg\"\r"
send "  welcomeBanner:\r"
send "    showOnFirstStart: true\r"
send "    title: \"Welcome to WonkaTech CTF Platform!\"\r"
send "    message: \"<p>This is your personal OWASP Juice Shop instance for the CTF challenge.</p><p>Find vulnerabilities and earn points!</p>\"\r"
send "  cookieConsent:\r"
send "    backgroundColor: \"#546e7a\"\r"
send "    textColor: \"#ffffff\"\r"
send "    buttonColor: \"#558b2f\"\r"
send "    buttonTextColor: \"#ffffff\"\r"
send "    message: \"This website uses cookies for CTF tracking.\"\r"
send "    dismissText: \"Accept\"\r"
send "    linkText: \"Learn more\"\r"
send "    linkUrl: \"https://wonkatech.org/privacy\"\r"
send "  securityTxt:\r"
send "    contact: \"wonkatech@gmail.com\"\r"
send "    encryption: \"https://wonkatech.org/pgp-key.txt\"\r"
send "    acknowledgements: \"https://wonkatech.org/security\"\r"
send "  promotion:\r"
send "    video: \"owasp_promo.mp4\"\r"
send "    subtitles: \"owasp_promo.vtt\"\r"
send "  easterEggPlanet:\r"
send "    name: \"WonkaPlanet\"\r"
send "    overlayMap: \"wonka-map.jpg\"\r"
send "products:\r"
send "  currency: \"USD\"\r"
send "  currencySymbol: \"\$\"\r"
send "EOF\r"
expect "# "

# Create startup script that uses the config
send "echo 'Creating startup script for containers...'\r"
expect "# "
send "cat > /root/start_juice_containers.sh << 'EOF'\r"
send "#!/bin/bash\r"
send "# Start Juice Shop containers with USD currency\r"
send "\r"
send "# Get all users from database\r"
send "users=\$(mysql -u root ctf_platform -e 'SELECT id FROM users;' 2>/dev/null | tail -n +2)\r"
send "\r"
send "for user_id in \$users; do\r"
send "    echo \"Starting container for user \$user_id...\"\r"
send "    docker run -d \\\\\r"
send "        --name juice-user\$user_id \\\\\r"
send "        -p \$((3000+user_id)):3000 \\\\\r"
send "        -e \"NODE_ENV=ctf\" \\\\\r"
send "        -e \"CTF_KEY=wonkatech-ctf-2025\" \\\\\r"
send "        -e \"PRODUCTS_CURRENCY=USD\" \\\\\r"
send "        -e \"PRODUCTS_CURRENCY_SYMBOL=\\\$\" \\\\\r"
send "        --restart unless-stopped \\\\\r"
send "        bkimminich/juice-shop\r"
send "done\r"
send "EOF\r"
expect "# "

send "chmod +x /root/start_juice_containers.sh\r"
expect "# "

# Start the containers with new configuration
send "echo ''\r"
expect "# "
send "echo 'Starting containers with USD currency...'\r"
expect "# "
send "/root/start_juice_containers.sh\r"
expect "# "

# Wait for containers to start
send "sleep 5\r"
expect "# "

# Verify containers are running
send "echo ''\r"
expect "# "
send "echo 'Verifying containers are running:'\r"
expect "# "
send "docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}' | grep juice\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'CURRENCY CONFIGURATION COMPLETE!'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo '✅ Juice Shop containers configured to use USD (\$)'\r"
expect "# "
send "echo '✅ All containers restarted with new configuration'\r"
expect "# "
send "echo '✅ Currency symbol changed from ¤ to \$'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'Users will now see prices in dollars (\$)'\r"
expect "# "
send "echo 'Example: Apple Pomace = \$0.89'\r"
expect "# "

send "exit\r"
expect eof