#!/usr/bin/expect -f

set timeout 60
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "cd /var/www/ctf-platform/\r"
expect "# "

# First, let's see the current line
send "grep -n instanceUrl dashboard.php | head -1\r"
expect "# "

# Now replace it using a simpler approach - edit line by line
send "sed -i '72s/.*/            \\\$instanceNumber = \\\$port - 3000;/' dashboard.php\r"
expect "# "

send "sed -i '72a\\            \\\$instanceUrl = \"https://instance\" . \\\$instanceNumber . \".wonkatech.org\";' dashboard.php\r"
expect "# "

# Remove the old instanceUrl line if it still exists
send "sed -i '/http:\\/\\/155.138.197.128/d' dashboard.php\r"
expect "# "

# Verify the change
send "echo 'Checking updated dashboard...'\r"
expect "# "
send "grep -B1 -A1 instanceUrl dashboard.php | head -5\r"
expect "# "

# Test one of the instance subdomains
send "echo ''\r"
expect "# "
send "echo 'Testing instance subdomain...'\r"
expect "# "
send "curl -s -I https://instance1.wonkatech.org 2>&1 | head -3\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Dashboard updated! Instances now use subdomain URLs.'\r"
expect "# "

send "exit\r"
expect eof