#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# Remove the broken lines
send "sed -i '/protocol: quic/d' /etc/cloudflared/config.yml\r"
expect "# "
send "sed -i '/edge-ip-version/d' /etc/cloudflared/config.yml\r"
expect "# "

# Restart cloudflared
send "systemctl restart cloudflared\r"
expect "# "

send "sleep 2\r"
expect "# "

# Check if running
send "systemctl is-active cloudflared\r"
expect "# "

# Check the actual error 525 - it's saying Cloudflare can't establish SSL to origin
# But with tunnel, it shouldn't be trying to connect directly!
# The issue might be that the DNS isn't pointing to the tunnel

send "echo ''\r"
expect "# "
send "echo 'Checking DNS resolution from Cloudflare perspective...'\r"
expect "# "

# Test if the platform works via direct tunnel test
send "curl -H 'Host: wonkatech.org' http://localhost:80 2>&1 | head -20\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'The tunnel is working locally. The issue is DNS routing.'\r"
expect "# "
send "echo 'In Cloudflare DNS, you should have:'\r"
expect "# "
send "echo '1. CNAME for @ -> 3e6698e3-59fb-4bb4-aa52-7dde59039354.cfargotunnel.com'\r"
expect "# "
send "echo '2. CNAME for * -> 3e6698e3-59fb-4bb4-aa52-7dde59039354.cfargotunnel.com'\r"
expect "# "
send "echo '3. NO A records at all'\r"
expect "# "

send "exit\r"
expect eof