#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" { send "$password\r" }
}
expect "# "

# Full restart of Apache
send "systemctl stop apache2\r"
expect "# "
send "systemctl start apache2\r"
expect "# "

# Check status
send "systemctl status apache2 | head -10\r"
expect "# "

# Test locally
send "curl http://localhost/ | head -10\r"
expect "# "

send "exit\r"
expect eof

puts "\n✅ Apache fully restarted!"