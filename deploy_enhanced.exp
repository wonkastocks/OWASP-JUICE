#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

# SCP the enhanced dashboard
spawn scp /Users/walterbarr_1/sql-injection-lab/dashboard_enhanced.php root@155.138.197.128:/tmp/dashboard.php

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect eof

# SSH and deploy
spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Backup and replace dashboard
send "cp /var/www/html/dashboard.php /var/www/html/dashboard.php.bak\r"
expect "# "

send "cp /tmp/dashboard.php /var/www/html/dashboard.php\r"
expect "# "

# Set permissions
send "chown www-data:www-data /var/www/html/dashboard.php\r"
expect "# "

send "chmod 644 /var/www/html/dashboard.php\r"
expect "# "

# Restart services
send "systemctl restart apache2\r"
expect "# "

send "systemctl restart php8.1-fpm\r"
expect "# "

send "echo 'Enhanced dashboard deployed!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nEnhanced dashboard deployed successfully!"