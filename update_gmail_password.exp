#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}
set app_password "bajiojxgyjhyxnhk"

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo 'Updating Gmail app password...'\r"
expect "# "

# Update the password file (removing spaces from app password)
send "cat > /etc/postfix/sasl_passwd << 'EOF'\r"
send "\[smtp.gmail.com\]:587 wonkatech@gmail.com:$app_password\r"
send "EOF\r"
expect "# "

# Set permissions and rebuild the database
send "chmod 600 /etc/postfix/sasl_passwd\r"
expect "# "
send "postmap /etc/postfix/sasl_passwd\r"
expect "# "

# Restart postfix
send "echo 'Restarting postfix...'\r"
expect "# "
send "systemctl restart postfix\r"
expect "# "
send "sleep 2\r"
expect "# "

# Check postfix status
send "systemctl status postfix | grep Active\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'Gmail configuration updated!'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "

# Create test email script
send "cat > /tmp/test_gmail.php << 'PHPTEST'\r"
send "<?php\r"
send "echo \\\"Sending test email through Gmail...\\\\n\\\\n\\\";\r"
send "\r"
send "\\\$to = 'wonkatech@gmail.com';\r"
send "\\\$subject = 'WonkaTech CTF Platform - Gmail Test';\r"
send "\\\$message = \\\"Hello!\\\\n\\\\n\\\";\r"
send "\\\$message .= \\\"This is a test email from the WonkaTech CTF Platform.\\\\n\\\\n\\\";\r"
send "\\\$message .= \\\"If you receive this email, it confirms that:\\\\n\\\";\r"
send "\\\$message .= \\\"1. Gmail SMTP is working correctly\\\\n\\\";\r"
send "\\\$message .= \\\"2. Emails can be sent from your platform\\\\n\\\";\r"
send "\\\$message .= \\\"3. Registration emails will work\\\\n\\\\n\\\";\r"
send "\\\$message .= \\\"Platform URL: https://wonkatech.org\\\\n\\\\n\\\";\r"
send "\\\$message .= \\\"Sent at: \\\" . date('Y-m-d H:i:s') . \\\"\\\\n\\\\n\\\";\r"
send "\\\$message .= \\\"Best regards,\\\\n\\\";\r"
send "\\\$message .= \\\"WonkaTech CTF Team\\\";\r"
send "\r"
send "\\\$headers = \\\"From: noreply@wonkatech.org\\\\r\\\\n\\\";\r"
send "\\\$headers .= \\\"Reply-To: noreply@wonkatech.org\\\\r\\\\n\\\";\r"
send "\\\$headers .= \\\"X-Mailer: PHP/\\\" . phpversion();\r"
send "\r"
send "if (mail(\\\$to, \\\$subject, \\\$message, \\\$headers)) {\r"
send "    echo \\\"✅ Test email sent successfully to wonkatech@gmail.com!\\\\n\\\";\r"
send "    echo \\\"Check your inbox - the email should arrive within 1-2 minutes.\\\\n\\\";\r"
send "} else {\r"
send "    echo \\\"❌ Failed to send test email\\\\n\\\";\r"
send "}\r"
send "?>\r"
send "PHPTEST\r"
expect "# "

# Run the test
send "php /tmp/test_gmail.php\r"
expect "# "

send "echo ''\r"
expect "# "

# Check mail queue
send "echo 'Checking mail queue:'\r"
expect "# "
send "mailq\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Check recent mail logs:'\r"
expect "# "
send "tail -10 /var/log/mail.log | grep -E 'status=|SASL|TLS'\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'Email test complete!'\r"
expect "# "
send "echo 'Check your wonkatech@gmail.com inbox now.'\r"
expect "# "
send "echo '================================================'\r"
expect "# "

send "exit\r"
expect eof