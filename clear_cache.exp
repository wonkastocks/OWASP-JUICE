#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Clear PHP opcache
send "systemctl restart php8.1-fpm\r"
expect "# "

# Clear Apache cache
send "systemctl restart apache2\r"
expect "# "

# Touch the file to update timestamp
send "touch /var/www/html/logintest.php\r"
expect "# "

send "echo 'Cache cleared!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nCache cleared!"