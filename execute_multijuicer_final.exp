#!/usr/bin/expect -f

set timeout 300
set password {$$R00tbeer02}

# Copy deployment script
spawn scp /tmp/deploy_real_multijuicer.sh root@155.138.197.128:/tmp/deploy_real_multijuicer.sh
expect {
    "(yes/no)?" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
}
expect eof

# Execute deployment
spawn ssh root@155.138.197.128 "chmod +x /tmp/deploy_real_multijuicer.sh && /tmp/deploy_real_multijuicer.sh"
expect {
    "password:" {
        send "$password\r"
    }
}
expect eof