#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

# Copy fixed reset_password file
spawn scp /tmp/reset_password_final.php root@155.138.197.128:/tmp/
expect {
    "password:" {
        send "$password\r"
        expect "100%"
    }
}

# SSH and fix
spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo 'Fixing reset password functionality...'\r"
expect "# "

# First, ensure the reset columns exist
send "echo 'Adding reset_token columns if missing...'\r"
expect "# "

# Check current columns
send "mysql -u root ctf_platform -e 'SHOW COLUMNS FROM users LIKE \"reset%\";' 2>/dev/null\r"
expect "# "

# Add reset_token column if it doesn't exist
send "mysql -u root ctf_platform -e 'ALTER TABLE users ADD COLUMN reset_token VARCHAR(64) DEFAULT NULL;' 2>&1 | grep -v 'Duplicate column' || true\r"
expect "# "

# Add reset_token_expiry column if it doesn't exist
send "mysql -u root ctf_platform -e 'ALTER TABLE users ADD COLUMN reset_token_expiry DATETIME DEFAULT NULL;' 2>&1 | grep -v 'Duplicate column' || true\r"
expect "# "

# Verify columns were added
send "echo ''\r"
expect "# "
send "echo 'Columns after fix:'\r"
expect "# "
send "mysql -u root ctf_platform -e 'SHOW COLUMNS FROM users LIKE \"reset%\";' 2>/dev/null\r"
expect "# "

# Deploy the fixed reset_password.php
send "echo ''\r"
expect "# "
send "echo 'Deploying fixed reset_password.php...'\r"
expect "# "
send "cp /tmp/reset_password_final.php /var/www/ctf-platform/reset_password.php\r"
expect "# "
send "chmod 644 /var/www/ctf-platform/reset_password.php\r"
expect "# "
send "chown www-data:www-data /var/www/ctf-platform/reset_password.php\r"
expect "# "

# Test PHP syntax
send "php -l /var/www/ctf-platform/reset_password.php\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'RESET PASSWORD FIX COMPLETE!'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo '✅ Fixed SQL syntax error in reset_password.php'\r"
expect "# "
send "echo '✅ Removed problematic ALTER TABLE statements from PHP'\r"
expect "# "
send "echo '✅ Added reset_token columns to database'\r"
expect "# "
send "echo '✅ Password reset now uses password_hash column correctly'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'Password reset should now work at: https://wonkatech.org/reset_password.php'\r"
expect "# "

send "exit\r"
expect eof