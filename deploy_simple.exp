#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

# SCP the file
spawn scp /Users/walterbarr_1/sql-injection-lab/logintest_simple.php root@155.138.197.128:/tmp/logintest.php

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect eof

# SSH and deploy
spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Move file to web directory
send "cp /tmp/logintest.php /var/www/html/logintest.php\r"
expect "# "

# Set permissions
send "chown www-data:www-data /var/www/html/logintest.php\r"
expect "# "

send "chmod 644 /var/www/html/logintest.php\r"
expect "# "

# Restart Apache and PHP
send "systemctl restart apache2\r"
expect "# "

send "systemctl restart php8.1-fpm\r"
expect "# "

# Test locally
send "curl -s http://localhost/logintest.php | grep -o Login\r"
expect "# "

send "echo 'Deployment complete!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nlogintest.php deployed successfully!"