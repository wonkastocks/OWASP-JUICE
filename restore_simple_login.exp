#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

send "echo 'Restoring simple login page...'\r"
expect "# "

# Copy logintest.php back to login.php (the simple minimal version)
send "cp /var/www/html/logintest.php /var/www/html/login.php\r"
expect "# "

# Keep dashboard.php as the enhanced version (dashboard_profile.php or dashboard_enhanced.php)
# Just ensure it's the one with user details
send "echo 'Keeping enhanced dashboard with user details'\r"
expect "# "

# Set permissions
send "chown www-data:www-data /var/www/html/login.php\r"
expect "# "

send "chmod 644 /var/www/html/login.php\r"
expect "# "

# Restart services
send "systemctl restart apache2\r"
expect "# "

send "systemctl restart php8.1-fpm\r"
expect "# "

send "echo 'Simple login restored. Users log in and see their dashboard.'\r"
expect "# "

send "exit\r"
expect eof

puts "\nSimple login page restored!"