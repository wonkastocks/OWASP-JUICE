#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

# SCP the dual mode login
spawn scp /Users/walterbarr_1/sql-injection-lab/login_dual_mode.php root@155.138.197.128:/tmp/login.php

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect eof

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

send "echo 'Deploying dual-mode login (SQL injection + normal)...'\r"
expect "# "

# Backup current login
send "cp /var/www/html/login.php /var/www/html/login.php.backup.`date +%Y%m%d_%H%M%S`\r"
expect "# "

# Deploy new dual-mode login
send "cp /tmp/login.php /var/www/html/login.php\r"
expect "# "

send "chown www-data:www-data /var/www/html/login.php\r"
expect "# "

send "chmod 644 /var/www/html/login.php\r"
expect "# "

send "systemctl restart apache2\r"
expect "# "

send "systemctl restart php8.1-fpm\r"
expect "# "

send "echo 'Dual-mode login deployed!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nDual-mode login deployed successfully!"