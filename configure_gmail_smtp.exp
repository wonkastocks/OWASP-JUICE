#!/usr/bin/expect -f

set timeout 300
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# Backup current configuration
send "cp /etc/postfix/main.cf /etc/postfix/main.cf.backup\r"
expect "# "

# Configure postfix for Gmail relay
send "cat > /etc/postfix/main.cf << 'EOF'\r"
send "# Basic configuration\r"
send "myhostname = wonkatech.org\r"
send "mydomain = wonkatech.org\r"
send "myorigin = \\\$mydomain\r"
send "inet_interfaces = loopback-only\r"
send "mydestination = \\\$myhostname, localhost.\\\$mydomain, localhost\r"
send "mynetworks = 127.0.0.0/8\r"
send "\r"
send "# Gmail SMTP relay configuration\r"
send "relayhost = [smtp.gmail.com]:587\r"
send "smtp_use_tls = yes\r"
send "smtp_sasl_auth_enable = yes\r"
send "smtp_sasl_security_options = noanonymous\r"
send "smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd\r"
send "smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt\r"
send "smtp_tls_security_level = encrypt\r"
send "smtp_tls_note_starttls_offer = yes\r"
send "\r"
send "# Additional settings\r"
send "smtp_generic_maps = hash:/etc/postfix/generic\r"
send "header_size_limit = 4096000\r"
send "EOF\r"
expect "# "

# Create password file (placeholder - needs app password)
send "cat > /etc/postfix/sasl_passwd << 'EOF'\r"
send "[smtp.gmail.com]:587 wonkastocks@gmail.com:YOUR_APP_PASSWORD_HERE\r"
send "EOF\r"
expect "# "

# Create generic maps for sender rewriting
send "cat > /etc/postfix/generic << 'EOF'\r"
send "root@wonkatech.org wonkastocks@gmail.com\r"
send "www-data@wonkatech.org wonkastocks@gmail.com\r"
send "noreply@wonkatech.org wonkastocks@gmail.com\r"
send "EOF\r"
expect "# "

# Set permissions
send "chmod 600 /etc/postfix/sasl_passwd\r"
expect "# "
send "postmap /etc/postfix/sasl_passwd\r"
expect "# "
send "postmap /etc/postfix/generic\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'GMAIL SMTP CONFIGURATION COMPLETE!'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'NOW YOU NEED TO:'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo '1. Get your Gmail App Password:'\r"
expect "# "
send "echo '   • Go to: https://myaccount.google.com/apppasswords'\r"
expect "# "
send "echo '   • Sign in with wonkastocks@gmail.com'\r"
expect "# "
send "echo '   • You may need to enable 2-factor authentication first'\r"
expect "# "
send "echo '   • Select \"Mail\" as the app'\r"
expect "# "
send "echo '   • Select \"Other\" as the device'\r"
expect "# "
send "echo '   • Name it: WonkaTech CTF'\r"
expect "# "
send "echo '   • Click Generate'\r"
expect "# "
send "echo '   • Copy the 16-character password (no spaces)'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo '2. Then I will help you update the password'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'The config files are ready and waiting for the app password.'\r"
expect "# "

send "exit\r"
expect eof