#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo '================================================'\r"
expect "# "
send "echo 'EMAIL SYSTEM STATUS'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "

# Check mail queue
send "echo 'Emails currently in queue (cannot be delivered due to port 25 block):'\r"
expect "# "
send "mailq\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'The issue: Port 25 is blocked by Vultr (cloud provider)'\r"
expect "# "
send "echo 'This is common security practice to prevent spam.'\r"
expect "# "
send "echo ''\r"
expect "# "

# Create a script to view email content locally
send "cat > /usr/local/bin/view_emails.php << 'PHPSCRIPT'\r"
send "#!/usr/bin/php\r"
send "<?php\r"
send "echo \\\"\\\\n=== VERIFICATION EMAIL VIEWER ===\\\\n\\\\n\\\";\r"
send "\r"
send "// Connect to database\r"
send "\\\$conn = new mysqli('localhost', 'root', '', 'ctf_platform');\r"
send "if (\\\$conn->connect_error) {\r"
send "    die(\\\"Connection failed: \\\" . \\\$conn->connect_error);\r"
send "}\r"
send "\r"
send "// Get unverified users\r"
send "\\\$sql = \\\"SELECT username, email, verification_token FROM users WHERE email_verified = 0\\\";\r"
send "\\\$result = \\\$conn->query(\\\$sql);\r"
send "\r"
send "if (\\\$result->num_rows > 0) {\r"
send "    echo \\\"Unverified users and their verification links:\\\\n\\\";\r"
send "    echo \\\"================================================\\\\n\\\\n\\\";\r"
send "    while(\\\$row = \\\$result->fetch_assoc()) {\r"
send "        echo \\\"Username: \\\" . \\\$row['username'] . \\\"\\\\n\\\";\r"
send "        echo \\\"Email: \\\" . \\\$row['email'] . \\\"\\\\n\\\";\r"
send "        echo \\\"Verification Link:\\\\n\\\";\r"
send "        echo \\\"https://wonkatech.org/verify.php?token=\\\" . \\\$row['verification_token'] . \\\"\\\\n\\\";\r"
send "        echo \\\"\\\\n---\\\\n\\\\n\\\";\r"
send "    }\r"
send "} else {\r"
send "    echo \\\"No unverified users found.\\\\n\\\";\r"
send "}\r"
send "\r"
send "\\\$conn->close();\r"
send "?>\r"
send "PHPSCRIPT\r"
expect "# "

send "chmod +x /usr/local/bin/view_emails.php\r"
expect "# "

# Run the viewer
send "/usr/local/bin/view_emails.php\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo 'SOLUTION:'\r"
expect "# "
send "echo '================================================'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'Since port 25 is blocked, emails cannot reach Gmail.'\r"
expect "# "
send "echo 'However, the platform IS generating the emails correctly.'\r"
expect "# "
send "echo ''\r"
expect "# "
send "echo 'For testing, you can:'\r"
expect "# "
send "echo '1. Use the verification links shown above directly'\r"
expect "# "
send "echo '2. The resend feature DOES work - it generates new tokens'\r"
expect "# "
send "echo '3. For production, you would need:'\r"
expect "# "
send "echo '   - An email service like SendGrid, Mailgun, or AWS SES'\r"
expect "# "
send "echo '   - Or request port 25 unblock from Vultr (usually requires justification)'\r"
expect "# "

send "exit\r"
expect eof