#!/usr/bin/expect -f

set timeout 30

# Connect to server
spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "\$\$R00tbeer02\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "\$\$R00tbeer02\r"
    }
}

expect "root@*"

# First check what containers are actually running
send "echo '=== Docker containers running ==='\r"
expect "root@*"
send "docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' | grep juice\r"
expect "root@*"

# Check the database assignments
send "echo '=== Database assignments ==='\r"
expect "root@*"
send "mysql -u root ctf_platform -e 'SELECT username, instance_url FROM users WHERE instance_url IS NOT NULL;' 2>/dev/null\r"
expect "root@*"

# Now fix the containers.php file to properly show data
send "echo '=== Fixing containers.php ==='\r"
expect "root@*"

# Backup current file
send "cp /var/www/html/admin/containers.php /var/www/html/admin/containers.php.backup\r"
expect "root@*"

# Create a working API endpoint for container data
send "cat > /var/www/html/admin/api_containers.php << 'ENDPHP'\r"
send "<?php\r"
send "session_start();\r"
send "header('Content-Type: application/json');\r"
send "\r"
send "// Check admin authentication\r"
send "if (!isset(\\\$_SESSION['admin_logged_in']) || \\\$_SESSION['admin_logged_in'] !== true) {\r"
send "    http_response_code(401);\r"
send "    echo json_encode(['error' => 'Unauthorized']);\r"
send "    exit();\r"
send "}\r"
send "\r"
send "// Get Docker containers\r"
send "function getDockerContainers() {\r"
send "    \\\$containers = [];\r"
send "    \\\$output = shell_exec('docker ps -a --format \"{{.Names}}|{{.Status}}|{{.Ports}}\" 2>/dev/null');\r"
send "    \r"
send "    if (\\\$output) {\r"
send "        \\\$lines = explode(\"\\\\n\", trim(\\\$output));\r"
send "        foreach (\\\$lines as \\\$line) {\r"
send "            if (strpos(\\\$line, 'juice') !== false) {\r"
send "                \\\$parts = explode('|', \\\$line);\r"
send "                if (count(\\\$parts) >= 2) {\r"
send "                    \\\$name = trim(\\\$parts[0]);\r"
send "                    \\\$status = strpos(\\\$parts[1], 'Up') !== false ? 'running' : 'stopped';\r"
send "                    \\\$port = isset(\\\$parts[2]) ? trim(\\\$parts[2]) : '';\r"
send "                    \r"
send "                    // Extract port number\r"
send "                    preg_match('/:(\\\\d+)->/', \\\$port, \\\$portMatch);\r"
send "                    \\\$portNum = isset(\\\$portMatch[1]) ? \\\$portMatch[1] : null;\r"
send "                    \r"
send "                    // Extract container number\r"
send "                    preg_match('/juice(\\\\d+)/', \\\$name, \\\$numMatch);\r"
send "                    \\\$containerNum = isset(\\\$numMatch[1]) ? \\\$numMatch[1] : null;\r"
send "                    \r"
send "                    if (\\\$containerNum) {\r"
send "                        \\\$containers[\\\$containerNum] = [\r"
send "                            'name' => \\\$name,\r"
send "                            'status' => \\\$status,\r"
send "                            'port' => \\\$portNum,\r"
send "                            'number' => \\\$containerNum\r"
send "                        ];\r"
send "                    }\r"
send "                }\r"
send "            }\r"
send "        }\r"
send "    }\r"
send "    \r"
send "    return \\\$containers;\r"
send "}\r"
send "\r"
send "// Get user assignments from database\r"
send "function getUserAssignments() {\r"
send "    \\\$assignments = [];\r"
send "    \r"
send "    \\\$conn = new mysqli('localhost', 'root', '', 'ctf_platform');\r"
send "    if (\\\$conn->connect_error) {\r"
send "        return \\\$assignments;\r"
send "    }\r"
send "    \r"
send "    \\\$sql = 'SELECT id, username, email, instance_url FROM users WHERE instance_url IS NOT NULL';\r"
send "    \\\$result = \\\$conn->query(\\\$sql);\r"
send "    \r"
send "    if (\\\$result) {\r"
send "        while (\\\$row = \\\$result->fetch_assoc()) {\r"
send "            // Extract container number from URL\r"
send "            if (preg_match('/juice(\\\\d+)/', \\\$row['instance_url'], \\\$matches)) {\r"
send "                \\\$containerNum = \\\$matches[1];\r"
send "                \\\$assignments[\\\$containerNum] = [\r"
send "                    'user_id' => \\\$row['id'],\r"
send "                    'username' => \\\$row['username'],\r"
send "                    'email' => \\\$row['email'],\r"
send "                    'url' => \\\$row['instance_url']\r"
send "                ];\r"
send "            }\r"
send "        }\r"
send "    }\r"
send "    \r"
send "    \\\$conn->close();\r"
send "    return \\\$assignments;\r"
send "}\r"
send "\r"
send "// Combine data\r"
send "\\\$containers = getDockerContainers();\r"
send "\\\$assignments = getUserAssignments();\r"
send "\r"
send "// Merge assignment data with container data\r"
send "\\\$fullData = [];\r"
send "for (\\\$i = 1; \\\$i <= 20; \\\$i++) {\r"
send "    \\\$containerData = isset(\\\$containers[\\\$i]) ? \\\$containers[\\\$i] : [\r"
send "        'name' => 'juice' . \\\$i,\r"
send "        'status' => 'not_created',\r"
send "        'port' => 3000 + \\\$i,\r"
send "        'number' => \\\$i\r"
send "    ];\r"
send "    \r"
send "    \\\$containerData['assigned_user'] = isset(\\\$assignments[\\\$i]) ? \\\$assignments[\\\$i] : null;\r"
send "    \\\$fullData[] = \\\$containerData;\r"
send "}\r"
send "\r"
send "// Calculate statistics\r"
send "\\\$stats = [\r"
send "    'total' => count(\\\$containers),\r"
send "    'running' => count(array_filter(\\\$containers, function(\\\$c) { return \\\$c['status'] == 'running'; })),\r"
send "    'assigned' => count(\\\$assignments),\r"
send "    'available' => count(\\\$containers) - count(\\\$assignments)\r"
send "];\r"
send "\r"
send "echo json_encode([\r"
send "    'success' => true,\r"
send "    'containers' => \\\$fullData,\r"
send "    'stats' => \\\$stats,\r"
send "    'timestamp' => date('Y-m-d H:i:s')\r"
send "]);\r"
send "?>\r"
send "ENDPHP\r"
expect "root@*"

# Set permissions
send "chown www-data:www-data /var/www/html/admin/api_containers.php\r"
expect "root@*"
send "chmod 644 /var/www/html/admin/api_containers.php\r"
expect "root@*"

# Test the new API
send "echo '=== Testing new API ==='\r"
expect "root@*"
send "curl -s http://localhost/admin/api_containers.php | python3 -c \"import sys, json; d=json.load(sys.stdin); print('Total containers:', d.get('stats',{}).get('total',0)); print('Assigned:', d.get('stats',{}).get('assigned',0))\" 2>/dev/null || echo 'Need session auth'\r"
expect "root@*"

# Create a test script to verify
send "php -r '\r"
send "\\\$_SESSION[\"admin_logged_in\"] = true;\r"
send "session_start();\r"
send "include \"/var/www/html/admin/api_containers.php\";' | python3 -m json.tool | head -30\r"
expect "root@*"

send "echo 'Dashboard API fixed!'\r"
expect "root@*"

send "exit\r"
expect eof