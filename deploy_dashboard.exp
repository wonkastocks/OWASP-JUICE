#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

# SCP all files
spawn scp /Users/walterbarr_1/sql-injection-lab/dashboard.php /Users/walterbarr_1/sql-injection-lab/logout.php /Users/walterbarr_1/sql-injection-lab/logintest_with_redirect.php root@155.138.197.128:/tmp/

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect eof

# SSH and deploy
spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Move files to web directory
send "cp /tmp/dashboard.php /var/www/html/dashboard.php\r"
expect "# "

send "cp /tmp/logout.php /var/www/html/logout.php\r"
expect "# "

send "cp /tmp/logintest_with_redirect.php /var/www/html/logintest.php\r"
expect "# "

# Set permissions
send "chown www-data:www-data /var/www/html/dashboard.php\r"
expect "# "

send "chown www-data:www-data /var/www/html/logout.php\r"
expect "# "

send "chown www-data:www-data /var/www/html/logintest.php\r"
expect "# "

send "chmod 644 /var/www/html/dashboard.php\r"
expect "# "

send "chmod 644 /var/www/html/logout.php\r"
expect "# "

send "chmod 644 /var/www/html/logintest.php\r"
expect "# "

# Create orders table if it doesn't exist
send "mysql -u root wallys_monkey_parts -e \"CREATE TABLE IF NOT EXISTS orders (id INT AUTO_INCREMENT PRIMARY KEY, user_id INT, order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP, total DECIMAL(10,2), status VARCHAR(50), item_count INT);\"\r"
expect "# "

# Add some sample orders for admin and john_doe
send "mysql -u root wallys_monkey_parts -e \"INSERT IGNORE INTO orders (user_id, total, status, item_count) VALUES (1, 156.99, 'completed', 3), (1, 89.50, 'shipped', 2), (2, 45.99, 'completed', 1), (2, 234.50, 'pending', 5);\"\r"
expect "# "

# Restart services
send "systemctl restart apache2\r"
expect "# "

send "systemctl restart php8.1-fpm\r"
expect "# "

send "echo 'Dashboard system deployed!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nDashboard deployed successfully!"