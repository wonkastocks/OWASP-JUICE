#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# First, install necessary email packages
send "apt-get update && apt-get install -y postfix mailutils -y\r"
expect "# "

# Configure Postfix for sending emails
send "echo 'wonkatech.org' > /etc/mailname\r"
expect "# "

# Fix the register.php to actually send emails instead of displaying the link
send "cd /var/www/ctf-platform/\r"
expect "# "

# Backup current register.php
send "cp register.php register.php.backup\r"
expect "# "

# Create the fixed register.php
send "cat > register_fixed.php << 'PHPEOF'\r"
send "<?php\r"
send "session_start();\r"
send "require_once 'config.php';\r"
send "require_once 'db.php';\r"
send "\r"
send "\\$error = '';\r"
send "\\$success = '';\r"
send "\r"
send "if (\\\$_SERVER['REQUEST_METHOD'] === 'POST') {\r"
send "    \\$username = trim(\\\$_POST['username']);\r"
send "    \\$email = trim(\\\$_POST['email']);\r"
send "    \\$password = \\\$_POST['password'];\r"
send "    \\$confirm_password = \\\$_POST['confirm_password'];\r"
send "    \r"
send "    // Validation\r"
send "    if (empty(\\$username) || empty(\\$email) || empty(\\$password)) {\r"
send "        \\$error = 'All fields are required';\r"
send "    } elseif (!filter_var(\\$email, FILTER_VALIDATE_EMAIL)) {\r"
send "        \\$error = 'Invalid email address';\r"
send "    } elseif (\\$password !== \\$confirm_password) {\r"
send "        \\$error = 'Passwords do not match';\r"
send "    } elseif (strlen(\\$password) < 8) {\r"
send "        \\$error = 'Password must be at least 8 characters';\r"
send "    } else {\r"
send "        // Check if username or email already exists\r"
send "        \\$stmt = \\$db->prepare('SELECT id FROM users WHERE username = ? OR email = ?');\r"
send "        \\$stmt->bind_param('ss', \\$username, \\$email);\r"
send "        \\$stmt->execute();\r"
send "        \\$result = \\$stmt->get_result();\r"
send "        \r"
send "        if (\\$result->num_rows > 0) {\r"
send "            \\$error = 'Username or email already exists';\r"
send "        } else {\r"
send "            // Create user\r"
send "            \\$password_hash = password_hash(\\$password, PASSWORD_DEFAULT);\r"
send "            \\$verification_token = bin2hex(random_bytes(32));\r"
send "            \r"
send "            \\$stmt = \\$db->prepare('INSERT INTO users (username, email, password_hash, verification_token, created_at) VALUES (?, ?, ?, ?, NOW())');\r"
send "            \\$stmt->bind_param('ssss', \\$username, \\$email, \\$password_hash, \\$verification_token);\r"
send "            \r"
send "            if (\\$stmt->execute()) {\r"
send "                // Send verification email\r"
send "                \\$verification_link = BASE_URL . '/verify.php?token=' . \\$verification_token;\r"
send "                \\$subject = 'WonkaTech CTF - Email Verification';\r"
send "                \\$message = \"Hello \\$username,\\n\\n\";\r"
send "                \\$message .= \"Please click the following link to verify your email address:\\n\\n\";\r"
send "                \\$message .= \\$verification_link . \"\\n\\n\";\r"
send "                \\$message .= \"If you didn't register for WonkaTech CTF, please ignore this email.\\n\\n\";\r"
send "                \\$message .= \"Best regards,\\nWonkaTech CTF Team\";\r"
send "                \r"
send "                \\$headers = 'From: noreply@wonkatech.org' . \"\\r\\n\" .\r"
send "                           'Reply-To: noreply@wonkatech.org' . \"\\r\\n\" .\r"
send "                           'X-Mailer: PHP/' . phpversion();\r"
send "                \r"
send "                if (mail(\\$email, \\$subject, \\$message, \\$headers)) {\r"
send "                    \\$success = 'Registration successful! Please check your email to verify your account.';\r"
send "                } else {\r"
send "                    \\$success = 'Registration successful but email could not be sent. Please contact admin.';\r"
send "                }\r"
send "            } else {\r"
send "                \\$error = 'Registration failed. Please try again.';\r"
send "            }\r"
send "        }\r"
send "    }\r"
send "}\r"
send "?>\r"
send "<!DOCTYPE html>\r"
send "<html lang=\"en\">\r"
send "<head>\r"
send "    <meta charset=\"UTF-8\">\r"
send "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r"
send "    <title>Register - WonkaTech CTF Platform</title>\r"
send "    <style>\r"
send "        * { margin: 0; padding: 0; box-sizing: border-box; }\r"
send "        body {\r"
send "            font-family: 'Segoe UI', sans-serif;\r"
send "            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r"
send "            min-height: 100vh;\r"
send "            display: flex;\r"
send "            align-items: center;\r"
send "            justify-content: center;\r"
send "        }\r"
send "        .container {\r"
send "            background: white;\r"
send "            border-radius: 20px;\r"
send "            padding: 40px;\r"
send "            box-shadow: 0 20px 60px rgba(0,0,0,0.3);\r"
send "            width: 90%;\r"
send "            max-width: 400px;\r"
send "        }\r"
send "        h1 { color: #333; margin-bottom: 10px; text-align: center; }\r"
send "        p { color: #666; margin-bottom: 30px; text-align: center; }\r"
send "        .form-group { margin-bottom: 20px; }\r"
send "        label { display: block; margin-bottom: 5px; color: #555; font-weight: 500; }\r"
send "        input { width: 100%; padding: 12px; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 16px; }\r"
send "        input:focus { outline: none; border-color: #667eea; }\r"
send "        button { width: 100%; padding: 14px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; }\r"
send "        button:hover { opacity: 0.9; }\r"
send "        .error { background: #ffebee; color: #c62828; padding: 10px; border-radius: 8px; margin-bottom: 20px; }\r"
send "        .success { background: #e8f5e9; color: #2e7d32; padding: 10px; border-radius: 8px; margin-bottom: 20px; }\r"
send "        .links { text-align: center; margin-top: 20px; }\r"
send "        .links a { color: #667eea; text-decoration: none; margin: 0 10px; }\r"
send "    </style>\r"
send "</head>\r"
send "<body>\r"
send "    <div class=\"container\">\r"
send "        <h1>🧃 WonkaTech CTF Platform</h1>\r"
send "        <p>Create your account to get your own Juice Shop instance</p>\r"
send "        \r"
send "        <?php if (\\$error): ?>\r"
send "            <div class=\"error\"><?php echo htmlspecialchars(\\$error); ?></div>\r"
send "        <?php endif; ?>\r"
send "        \r"
send "        <?php if (\\$success): ?>\r"
send "            <div class=\"success\"><?php echo htmlspecialchars(\\$success); ?></div>\r"
send "        <?php else: ?>\r"
send "        \r"
send "        <form method=\"POST\">\r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"username\">Username</label>\r"
send "                <input type=\"text\" id=\"username\" name=\"username\" required>\r"
send "            </div>\r"
send "            \r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"email\">Email Address</label>\r"
send "                <input type=\"email\" id=\"email\" name=\"email\" required>\r"
send "            </div>\r"
send "            \r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"password\">Password</label>\r"
send "                <input type=\"password\" id=\"password\" name=\"password\" required>\r"
send "            </div>\r"
send "            \r"
send "            <div class=\"form-group\">\r"
send "                <label for=\"confirm_password\">Confirm Password</label>\r"
send "                <input type=\"password\" id=\"confirm_password\" name=\"confirm_password\" required>\r"
send "            </div>\r"
send "            \r"
send "            <button type=\"submit\">Register</button>\r"
send "        </form>\r"
send "        \r"
send "        <?php endif; ?>\r"
send "        \r"
send "        <div class=\"links\">\r"
send "            <a href=\"/login.php\">Already have an account? Login here</a><br><br>\r"
send "            <a href=\"/\">Back to Home</a>\r"
send "        </div>\r"
send "    </div>\r"
send "</body>\r"
send "</html>\r"
send "PHPEOF\r"
expect "# "

# Replace the old register.php with the fixed one
send "mv register_fixed.php register.php\r"
expect "# "

# Configure sendmail as alternative if postfix doesn't work
send "which sendmail\r"
expect "# "

# Create a simple mail configuration
send "echo 'sendmail_path = /usr/sbin/sendmail -t -i' >> /etc/php/8.1/apache2/php.ini\r"
expect "# "

# Restart Apache to apply PHP changes
send "systemctl restart apache2\r"
expect "# "

send "echo 'Email verification system fixed!'\r"
expect "# "
send "echo 'Now registration will:'\r"
expect "# "
send "echo '1. Show success message asking user to check email'\r"
expect "# "
send "echo '2. Send actual email with verification link'\r"
expect "# "
send "echo '3. NOT display the verification link on the page'\r"
expect "# "

send "exit\r"
expect eof