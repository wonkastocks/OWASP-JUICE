send "        }\r"
send "        .instance-card:hover { transform: translateY(-5px); }\r"
send "        .user-icon { font-size: 48px; margin-bottom: 15px; }\r"
send "        .instance-title { font-size: 1.5em; color: #333; margin-bottom: 10px; }\r"
send "        .instance-port { color: #666; margin-bottom: 20px; }\r"
send "        .launch-btn {\r"
send "            display: inline-block;\r"
send "            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r"
