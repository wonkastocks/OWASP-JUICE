#!/usr/bin/expect -f

set timeout 30
# Password with dollar sign
set password "\\\$R00tbeer02"

spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "$password\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "$password\r"
    }
}

expect "# "

# Use sed commands to remove footer sections
send "sed -i '/<footer>/,/<\\/footer>/d' /var/www/html/login.php\r"
expect "# "

# Remove shop section and everything after
send "sed -i '/#### 🛍️ Shop/,\$d' /var/www/html/login.php\r"
expect "# "

# Add closing tags back
send "echo '</body>' >> /var/www/html/login.php\r"
expect "# "

send "echo '</html>' >> /var/www/html/login.php\r"
expect "# "

# Restart Apache
send "systemctl restart apache2\r"
expect "# "

send "echo 'Footer sections removed!'\r"
expect "# "

send "exit\r"
expect eof

puts "\nFooter removal complete!"