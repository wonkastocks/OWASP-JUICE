#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "cd /var/www/ctf-platform/\r"
expect "# "

# Backup files before making changes
send "cp login.php login.php.backup_resend\r"
expect "# "

# Create resend_verification.php
send "cat > resend_verification.php << 'PHPEND'\r"
send "<?php\r"
send "session_start();\r"
send "require_once 'config.php';\r"
send "\r"
send "\\\$message = '';\r"
send "\\\$error = '';\r"
send "\r"
send "// Handle resend request\r"
send "if (\\\$_SERVER['REQUEST_METHOD'] === 'POST' && isset(\\\$_POST['email'])) {\r"
send "    \\\$email = filter_var(\\\$_POST['email'], FILTER_SANITIZE_EMAIL);\r"
send "    \r"
send "    if (filter_var(\\\$email, FILTER_VALIDATE_EMAIL)) {\r"
send "        // Check if user exists and is not verified\r"
send "        \\\$stmt = \\\$pdo->prepare(\"SELECT id, username, email_verified, verification_token FROM users WHERE email = ?\");\r"
send "        \\\$stmt->execute([\\\$email]);\r"
send "        \\\$user = \\\$stmt->fetch();\r"
send "        \r"
send "        if (\\\$user) {\r"
send "            if (\\\$user['email_verified'] == 1) {\r"
send "                \\\$error = \"This email is already verified. You can login.\";\r"
send "            } else {\r"
send "                // Generate new verification token\r"
send "                \\\$newToken = bin2hex(random_bytes(32));\r"
send "                \r"
send "                // Update token in database\r"
send "                \\\$updateStmt = \\\$pdo->prepare(\"UPDATE users SET verification_token = ? WHERE id = ?\");\r"
send "                \\\$updateStmt->execute([\\\$newToken, \\\$user['id']]);\r"
send "                \r"
send "                // Send verification email\r"
send "                \\\$to = \\\$email;\r"
send "                \\\$subject = \"WonkaTech CTF - Email Verification (Resent)\";\r"
send "                \\\$verificationLink = BASE_URL . \"/verify.php?token=\" . \\\$newToken;\r"
send "                \r"
send "                \\\$emailMessage = \"Hello \" . \\\$user['username'] . \",\\n\\n\";\r"
send "                \\\$emailMessage .= \"You requested to resend your verification email.\\n\\n\";\r"
send "                \\\$emailMessage .= \"Please click the link below to verify your email:\\n\\n\";\r"
send "                \\\$emailMessage .= \\\$verificationLink . \"\\n\\n\";\r"
send "                \\\$emailMessage .= \"This link will expire in 24 hours.\\n\\n\";\r"
send "                \\\$emailMessage .= \"If you did not request this, please ignore this email.\\n\\n\";\r"
send "                \\\$emailMessage .= \"Best regards,\\n\";\r"
send "                \\\$emailMessage .= \"WonkaTech CTF Team\";\r"
send "                \r"
send "                \\\$headers = \"From: noreply@wonkatech.org\\r\\n\";\r"
send "                \\\$headers .= \"Reply-To: noreply@wonkatech.org\\r\\n\";\r"
send "                \\\$headers .= \"X-Mailer: PHP/\" . phpversion();\r"
send "                \r"
send "                if (@mail(\\\$to, \\\$subject, \\\$emailMessage, \\\$headers)) {\r"
send "                    \\\$message = \"Verification email has been resent to \" . \\\$email . \". Please check your inbox.\";\r"
send "                } else {\r"
send "                    \\\$error = \"Failed to send email. Please try again later.\";\r"
send "                }\r"
send "            }\r"
send "        } else {\r"
send "            \\\$error = \"No account found with this email address.\";\r"
send "        }\r"
send "    } else {\r"
send "        \\\$error = \"Please enter a valid email address.\";\r"
send "    }\r"
send "}\r"
send "?>\r"
send "<!DOCTYPE html>\r"
send "<html lang=\"en\">\r"
send "<head>\r"
send "    <meta charset=\"UTF-8\">\r"
send "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r"
send "    <title>Resend Verification - WonkaTech CTF</title>\r"
send "    <link rel=\"stylesheet\" href=\"assets/css/style.css\">\r"
send "</head>\r"
send "<body>\r"
send "    <div class=\"container\">\r"
send "        <div class=\"auth-box\">\r"
send "            <h1>🔄 Resend Verification Email</h1>\r"
send "            <p>Enter your email address to receive a new verification link</p>\r"
send "            \r"
send "            <?php if (\\\$message): ?>\r"
send "                <div class=\"success-message\"><?php echo htmlspecialchars(\\\$message); ?></div>\r"
send "            <?php endif; ?>\r"
send "            \r"
send "            <?php if (\\\$error): ?>\r"
send "                <div class=\"error-message\"><?php echo htmlspecialchars(\\\$error); ?></div>\r"
send "            <?php endif; ?>\r"
send "            \r"
send "            <form method=\"POST\" action=\"resend_verification.php\">\r"
send "                <div class=\"form-group\">\r"
send "                    <label for=\"email\">Email Address</label>\r"
send "                    <input type=\"email\" id=\"email\" name=\"email\" required \r"
send "                           placeholder=\"Enter your email address\"\r"
send "                           value=\"<?php echo isset(\\\$_POST['email']) ? htmlspecialchars(\\\$_POST['email']) : ''; ?>\">\r"
send "                </div>\r"
send "                \r"
send "                <button type=\"submit\" class=\"btn btn-primary\">Resend Verification Email</button>\r"
send "            </form>\r"
send "            \r"
send "            <div class=\"auth-links\">\r"
send "                <a href=\"login.php\">Back to Login</a>\r"
send "                <a href=\"register.php\">Create New Account</a>\r"
send "            </div>\r"
send "        </div>\r"
send "    </div>\r"
send "</body>\r"
send "</html>\r"
send "PHPEND\r"
expect "# "

# Now update login.php to show resend link for unverified users
send "cat > update_login.php << 'PHPSCRIPT'\r"
send "<?php\r"
send "// Read login.php\r"
send "\\\$content = file_get_contents('login.php');\r"
send "\r"
send "// Find the error message section and add check for unverified email\r"
send "\\\$search = '\\\$error = \"Invalid username or password.\";';\r"
send "\\\$replace = '// Check if email is verified\r"
send "                \\\$stmt = \\\$pdo->prepare(\"SELECT email_verified FROM users WHERE username = ? OR email = ?\");\r"
send "                \\\$stmt->execute([\\\$username, \\\$username]);\r"
send "                \\\$userCheck = \\\$stmt->fetch();\r"
send "                \r"
send "                if (\\\$userCheck && \\\$userCheck[\"email_verified\"] == 0) {\r"
send "                    \\\$error = \"Your email is not verified. <a href=\\\"resend_verification.php\\\">Click here to resend verification email</a>\";\r"
send "                } else {\r"
send "                    \\\$error = \"Invalid username or password.\";\r"
send "                }';\r"
send "\r"
send "// Replace in file\r"
send "\\\$content = str_replace(\\\$search, \\\$replace, \\\$content);\r"
send "\r"
send "// Save the updated file\r"
send "file_put_contents('login.php', \\\$content);\r"
send "echo \"login.php updated with resend verification link\\n\";\r"
send "?>\r"
send "PHPSCRIPT\r"
expect "# "

# Run the PHP script to update login.php
send "php update_login.php\r"
expect "# "

# Clean up
send "rm update_login.php\r"
expect "# "

# Set proper permissions
send "chown www-data:www-data resend_verification.php\r"
expect "# "
send "chmod 644 resend_verification.php\r"
expect "# "

# Verify PHP syntax
send "php -l resend_verification.php\r"
expect "# "
send "php -l login.php\r"
expect "# "

# Restart Apache
send "systemctl restart apache2\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Resend verification functionality added successfully!'\r"
expect "# "
send "echo 'Users can now:'\r"
expect "# "
send "echo '1. See a resend link on login page if email not verified'\r"
expect "# "
send "echo '2. Visit resend_verification.php to get a new verification email'\r"
expect "# "

send "exit\r"
expect eof