#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

# Check all docker containers
send "docker ps -a\r"
expect "# "

# Check if k3s is still running
send "systemctl status k3s | head -5\r"
expect "# "

# Stop k3s if running
send "systemctl stop k3s 2>/dev/null\r"
expect "# "
send "k3s-uninstall.sh 2>/dev/null\r"
expect "# "

# Check what's actually being served
send "wget -qO- http://localhost/ 2>&1 | head -20\r"
expect "# "

# Try accessing the file directly
send "cat /var/www/html/index.html | grep '<title>'\r"
expect "# "

send "exit\r"
expect eof