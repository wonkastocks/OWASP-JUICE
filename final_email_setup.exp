#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "cd /var/www/ctf-platform/\r"
expect "# "

# First restore from backup to fix the syntax error
send "cp login.php.backup_resend login.php\r"
expect "# "

# Create a PHP script to properly add the resend link
send "cat > add_resend.php << 'PHPEND'\r"
send "<?php\r"
send "\\\$content = file_get_contents('login.php');\r"
send "\r"
send "// Find and replace the error message for unverified users\r"
send "\\\$search = '\\\$error = \"Please verify your email before logging in.\";';\r"
send "\\\$replace = '\\\$error = \"Please verify your email before logging in. <a href=\\\\\\\\\"resend_verification.php\\\\\\\\\" style=\\\\\\\\\"color: #667eea; text-decoration: underline;\\\\\\\\\">Click here to resend verification email</a>\";';\r"
send "\r"
send "\\\$content = str_replace(\\\$search, \\\$replace, \\\$content);\r"
send "\r"
send "file_put_contents('login.php', \\\$content);\r"
send "echo \"Fixed login.php - resend link added for unverified users\\\\n\";\r"
send "?>\r"
send "PHPEND\r"
expect "# "

# Run the PHP script
send "php add_resend.php\r"
expect "# "

# Clean up
send "rm add_resend.php\r"
expect "# "

# Verify PHP syntax is correct
send "php -l login.php\r"
expect "# "

# Restart Apache
send "systemctl restart apache2\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Fixed! The resend link will now show ONLY for unverified users.'\r"
expect "# "

send "exit\r"
expect eof