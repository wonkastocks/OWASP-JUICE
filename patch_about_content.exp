#!/usr/bin/expect -f

set timeout 120
set password {$$R00tbeer02}

# SSH and patch the About content
spawn ssh root@155.138.197.128
expect {
    "password:" {
        send "$password\r"
        expect "# "
    }
}

send "echo 'Patching About Us content in Juice Shop containers...'\r"
expect "# "
send "echo '================================================'\r"
expect "# "

# Create patch script
send "cat > /tmp/patch_about.sh << 'SCRIPT_EOF'\r"
send "#!/bin/bash\r"
send "\r"
send "# Function to patch a container\r"
send "patch_container() {\r"
send "    CONTAINER=\$1\r"
send "    echo \"Patching \$CONTAINER...\"\r"
send "    \r"
send "    # Find the main JavaScript bundle\r"
send "    docker exec \$CONTAINER find /juice-shop/frontend/dist/frontend -name 'main*.js' -type f > /tmp/mainjs.txt\r"
send "    MAIN_JS=\$(head -1 /tmp/mainjs.txt)\r"
send "    \r"
send "    if \[ -z \"\$MAIN_JS\" \]; then\r"
send "        echo \"Could not find main.js in \$CONTAINER\"\r"
send "        return\r"
send "    fi\r"
send "    \r"
send "    # Create backup\r"
send "    docker exec \$CONTAINER cp \"\$MAIN_JS\" \"\$MAIN_JS.bak\"\r"
send "    \r"
send "    # Replace Lorem Ipsum with meaningful content\r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua./Founded in 2014, OWASP Juice Shop started as a small family-owned business with a simple mission: to deliver fresh, organic juices directly to your doorstep. What began in a small kitchen has grown into a leading online juice retailer./g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/At vero eos et accusam et justo duo dolores et ea rebum./We pride ourselves on our commitment to quality and sustainability. Every juice is made from locally-sourced, organic fruits and vegetables./g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/Stet clita kasd gubergren, no sea takimata sanctus est/Our state-of-the-art facility maintains the highest standards of food safety/g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/Lorem ipsum dolor sit amet./Thank you for choosing OWASP Juice Shop./g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi./Through our Juice for All program, we donate 1 percent of all sales to local food banks and nutrition education programs. We also partner with local farms to reduce food waste by purchasing imperfect produce./g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat./Your feedback drives our innovation. We actively listen to our customers and continuously improve our products based on your suggestions./g' \$MAIN_JS\"\r"
send "    \r"
send "    docker exec \$CONTAINER bash -c \"sed -i 's/At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet./Feel free to leave a review or contact our customer service team. We read every message and take your input seriously./g' \$MAIN_JS\"\r"
send "    \r"
send "    # Restart container to apply changes\r"
send "    docker restart \$CONTAINER\r"
send "    \r"
send "    echo \"Container \$CONTAINER patched successfully\"\r"
send "}\r"
send "\r"
send "# Patch all containers\r"
send "for i in 1 2 3 4 5; do\r"
send "    patch_container juice-user\$i\r"
send "done\r"
send "\r"
send "echo ''\r"
send "echo 'All containers patched successfully!'\r"
send "echo 'The About Us page now shows meaningful content.'\r"
send "echo 'IMPORTANT: The CTF link to /ftp/legal.md remains intact.'\r"
send "SCRIPT_EOF\r"
expect "# "

send "chmod +x /tmp/patch_about.sh\r"
expect "# "

send "echo 'Running patch script...'\r"
expect "# "
send "/tmp/patch_about.sh\r"
expect "# "

send "echo ''\r"
expect "# "
send "echo 'Verification complete. All containers have been updated.'\r"
expect "# "
send "echo 'The About Us page now displays meaningful juice shop content'\r"
expect "# "
send "echo 'while preserving the CTF challenge link.'\r"
expect "# "

send "exit\r"
expect eof