#!/usr/bin/expect -f

set timeout 60

# Connect to server
spawn ssh root@155.138.197.128

expect {
    "password:" {
        send "\$\$R00tbeer02\r"
    }
    "yes/no" {
        send "yes\r"
        expect "password:"
        send "\$\$R00tbeer02\r"
    }
}

expect "root@*"

# Create backup of current admin files
send "cp -r /var/www/html/admin /var/www/html/admin.backup.$(date +%Y%m%d_%H%M%S)\r"
expect "root@*"

# Update the admin dashboard to show real container status
send "cat > /var/www/html/admin/get_container_status.php << 'ENDPHP'\r"
send "<?php\r"
send "// Get real-time container status\r"
send "function getContainerStatus() {\r"
send "    \\\$containers = array();\r"
send "    \r"
send "    // Get Docker container status\r"
send "    \\\$output = shell_exec('docker ps -a --format \"table {{.Names}}|{{.Status}}|{{.Ports}}\" | grep juice');\r"
send "    if(\\\$output) {\r"
send "        \\\$lines = explode(\"\\n\", trim(\\\$output));\r"
send "        foreach(\\\$lines as \\\$line) {\r"
send "            \\\$parts = explode('|', \\\$line);\r"
send "            if(count(\\\$parts) >= 2) {\r"
send "                \\\$name = trim(\\\$parts[0]);\r"
send "                \\\$status = strpos(\\\$parts[1], 'Up') !== false ? 'running' : 'stopped';\r"
send "                \\\$port = isset(\\\$parts[2]) ? trim(\\\$parts[2]) : '';\r"
send "                \r"
send "                // Extract container number\r"
send "                if(preg_match('/juice(\\d+)/', \\\$name, \\\$matches)) {\r"
send "                    \\\$containers[\\\$matches[1]] = array(\r"
send "                        'name' => \\\$name,\r"
send "                        'status' => \\\$status,\r"
send "                        'port' => \\\$port,\r"
send "                        'number' => \\\$matches[1]\r"
send "                    );\r"
send "                }\r"
send "            }\r"
send "        }\r"
send "    }\r"
send "    return \\\$containers;\r"
send "}\r"
send "\r"
send "// Get user assignments from database\r"
send "function getUserAssignments() {\r"
send "    \\\$conn = new mysqli('localhost', 'root', 'WonkaChocolate2024!', 'ctf_platform');\r"
send "    if(\\\$conn->connect_error) {\r"
send "        return array();\r"
send "    }\r"
send "    \r"
send "    \\\$users = array();\r"
send "    \\\$result = \\\$conn->query('SELECT id, username, email, instance_url, is_verified, created_at FROM users');\r"
send "    if(\\\$result) {\r"
send "        while(\\\$row = \\\$result->fetch_assoc()) {\r"
send "            // Extract container number from URL\r"
send "            \\\$container_num = null;\r"
send "            if(\\\$row['instance_url'] && preg_match('/juice(\\d+)/', \\\$row['instance_url'], \\\$matches)) {\r"
send "                \\\$container_num = \\\$matches[1];\r"
send "            }\r"
send "            \\\$users[] = array(\r"
send "                'id' => \\\$row['id'],\r"
send "                'username' => \\\$row['username'],\r"
send "                'email' => \\\$row['email'],\r"
send "                'container' => \\\$container_num,\r"
send "                'instance_url' => \\\$row['instance_url'],\r"
send "                'verified' => \\\$row['is_verified'],\r"
send "                'created' => \\\$row['created_at']\r"
send "            );\r"
send "        }\r"
send "    }\r"
send "    \\\$conn->close();\r"
send "    return \\\$users;\r"
send "}\r"
send "\r"
send "// Output JSON for AJAX calls\r"
send "header('Content-Type: application/json');\r"
send "echo json_encode(array(\r"
send "    'containers' => getContainerStatus(),\r"
send "    'users' => getUserAssignments()\r"
send "));\r"
send "?>\r"
send "ENDPHP\r"
expect "root@*"

# Update the main dashboard index.php
send "cat > /var/www/html/admin/dashboard_content.php << 'ENDPHP'\r"
send "<?php\r"
send "session_start();\r"
send "if(!isset(\\\$_SESSION['admin_logged_in']) || \\\$_SESSION['admin_logged_in'] !== true) {\r"
send "    header('Location: admin_login.php');\r"
send "    exit();\r"
send "}\r"
send "?>\r"
send "<!DOCTYPE html>\r"
send "<html>\r"
send "<head>\r"
send "    <title>CTF Admin Dashboard</title>\r"
send "    <style>\r"
send "        body { font-family: Arial, sans-serif; margin: 20px; }\r"
send "        .stats { display: flex; gap: 20px; margin-bottom: 30px; }\r"
send "        .stat-card { background: #f0f0f0; padding: 20px; border-radius: 8px; flex: 1; }\r"
send "        .stat-card h3 { margin: 0 0 10px 0; color: #333; }\r"
send "        .stat-card .value { font-size: 2em; font-weight: bold; color: #5e35b1; }\r"
send "        table { width: 100%; border-collapse: collapse; margin-top: 20px; }\r"
send "        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }\r"
send "        th { background-color: #5e35b1; color: white; }\r"
send "        .status-running { color: green; font-weight: bold; }\r"
send "        .status-stopped { color: red; font-weight: bold; }\r"
send "        .verified { color: green; }\r"
send "        .unverified { color: orange; }\r"
send "    </style>\r"
send "    <script src='https://code.jquery.com/jquery-3.6.0.min.js'></script>\r"
send "</head>\r"
send "<body>\r"
send "    <h1>WonkaTech CTF Admin Dashboard</h1>\r"
send "    <div class='stats' id='stats'>Loading statistics...</div>\r"
send "    <h2>Container Status</h2>\r"
send "    <table id='containers'>\r"
send "        <thead><tr><th>Container</th><th>Status</th><th>Port</th><th>Assigned User</th></tr></thead>\r"
send "        <tbody>Loading...</tbody>\r"
send "    </table>\r"
send "    <h2>User Overview</h2>\r"
send "    <table id='users'>\r"
send "        <thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Container</th><th>Verified</th><th>Created</th></tr></thead>\r"
send "        <tbody>Loading...</tbody>\r"
send "    </table>\r"
send "    <script>\r"
send "    function loadDashboard() {\r"
send "        \\\$.getJSON('get_container_status.php', function(data) {\r"
send "            // Update statistics\r"
send "            var totalUsers = data.users.length;\r"
send "            var verifiedUsers = data.users.filter(u => u.verified == 1).length;\r"
send "            var runningContainers = Object.values(data.containers).filter(c => c.status == 'running').length;\r"
send "            \r"
send "            \\\$('#stats').html(\r"
send "                '<div class=\"stat-card\"><h3>Total Users</h3><div class=\"value\">' + totalUsers + '</div></div>' +\r"
send "                '<div class=\"stat-card\"><h3>Verified Users</h3><div class=\"value\">' + verifiedUsers + '</div></div>' +\r"
send "                '<div class=\"stat-card\"><h3>Running Containers</h3><div class=\"value\">' + runningContainers + '</div></div>'\r"
send "            );\r"
send "            \r"
send "            // Update container table\r"
send "            var containerHtml = '';\r"
send "            for(var i = 1; i <= 15; i++) {\r"
send "                var container = data.containers[i] || {name: 'juice'+i, status: 'stopped', port: '-'};\r"
send "                var assignedUser = data.users.find(u => u.container == i);\r"
send "                containerHtml += '<tr>';\r"
send "                containerHtml += '<td>' + container.name + '</td>';\r"
send "                containerHtml += '<td class=\"status-' + container.status + '\">' + container.status.toUpperCase() + '</td>';\r"
send "                containerHtml += '<td>' + (container.port || '-') + '</td>';\r"
send "                containerHtml += '<td>' + (assignedUser ? assignedUser.username : 'Available') + '</td>';\r"
send "                containerHtml += '</tr>';\r"
send "            }\r"
send "            \\\$('#containers tbody').html(containerHtml);\r"
send "            \r"
send "            // Update users table\r"
send "            var userHtml = '';\r"
send "            data.users.forEach(function(user) {\r"
send "                userHtml += '<tr>';\r"
send "                userHtml += '<td>' + user.id + '</td>';\r"
send "                userHtml += '<td>' + user.username + '</td>';\r"
send "                userHtml += '<td>' + user.email + '</td>';\r"
send "                userHtml += '<td>' + (user.container ? 'juice' + user.container : 'None') + '</td>';\r"
send "                userHtml += '<td class=\"' + (user.verified ? 'verified' : 'unverified') + '\">' + (user.verified ? 'Yes' : 'No') + '</td>';\r"
send "                userHtml += '<td>' + user.created + '</td>';\r"
send "                userHtml += '</tr>';\r"
send "            });\r"
send "            \\\$('#users tbody').html(userHtml);\r"
send "        });\r"
send "    }\r"
send "    \r"
send "    // Load dashboard on page load and refresh every 30 seconds\r"
send "    loadDashboard();\r"
send "    setInterval(loadDashboard, 30000);\r"
send "    </script>\r"
send "</body>\r"
send "</html>\r"
send "ENDPHP\r"
expect "root@*"

# Set permissions
send "chown -R www-data:www-data /var/www/html/admin/\r"
expect "root@*"

send "chmod 755 /var/www/html/admin/*.php\r"
expect "root@*"

# Restart Apache
send "systemctl restart apache2\r"
expect "root@*"

send "echo 'Dashboard updated successfully!'\r"
expect "root@*"

send "exit\r"
expect eof