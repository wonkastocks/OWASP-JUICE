#!/usr/bin/expect -f

set timeout 30
set password {$$R00tbeer02}

# Copy update script
spawn scp /tmp/update_landing.sh root@155.138.197.128:/tmp/update_landing.sh
expect {
    "(yes/no)?" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
    }
}
expect eof

# Execute update
spawn ssh root@155.138.197.128 "chmod +x /tmp/update_landing.sh && /tmp/update_landing.sh"
expect {
    "password:" {
        send "$password\r"
    }
}
expect eof